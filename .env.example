# PostgreSQL Database
POSTGRES_HOST=ebertx.duckdns.org
POSTGRES_PORT=5432
POSTGRES_USER=ebertx
POSTGRES_PASSWORD=your_password_here
POSTGRES_DATABASE=polybot

# Polymarket Wallet Address
POLYMARKET_WALLET=0x...

# Polling Configuration
POLL_INTERVAL_SECONDS=60

# Optional: Log level
LOG_LEVEL=INFO

# Authentication
# Generate password hash: python -c "from passlib.hash import bcrypt; print(bcrypt.hash('your-password'))"
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=$2b$12$...your_bcrypt_hash_here...
JWT_SECRET_KEY=change-this-to-a-random-string-in-production

# /docs markdown viewer (app/routers/docs.py)
# HMAC secret shared with polymarket-team ops/kryten/hermes-scripts/doc_link.py (same value on Kryten)
DOCS_LINK_SECRET=
# Fine-grained GitHub PAT, read-only Contents on ebertx/polymarket-team
GITHUB_DOCS_TOKEN=
